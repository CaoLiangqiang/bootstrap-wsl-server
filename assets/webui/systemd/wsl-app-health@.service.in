[Unit]
Description=Read-only health check for registered WSL WebUI app %i
ConditionFileIsExecutable=__INSTALL_DIR__/scripts/check-app-health.py

[Service]
Type=oneshot
ExecStart=__INSTALL_DIR__/scripts/check-app-health.py --app %i
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ProtectControlGroups=true
ProtectKernelModules=true
ProtectKernelTunables=true
RestrictSUIDSGID=true
